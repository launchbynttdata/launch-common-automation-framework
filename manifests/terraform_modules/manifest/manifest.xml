<?xml version="1.0" encoding="UTF-8"?>
<!--
    This manifest defines terraform_module component dependencies for all Terraform modules.
    Files are copied (not symlinked) from component repositories into the consuming module.
    Uses copyfile to avoid Windows symlink issues and simplify Git tracking.
-->
<manifest>
  <project name="lcaf-component-terraform" path="components/module" remote="launch-dso-platform" revision="refs/tags/1.1.0" dso_override_attribute_revision='${TERRAFORM_VER}'>
    <copyfile src="linkfiles/Makefile" dest="components/Makefile" />
    <copyfile src="linkfiles/.tflint.hcl" dest=".tflint.hcl" />
    <copyfile src="linkfiles/.pre-commit-config.yaml" dest=".pre-commit-config.yaml" />
    <copyfile src="linkfiles/.golangci.yaml" dest=".golangci.yaml" />
    <copyfile src="linkfiles/.secrets.baseline" dest=".secrets.baseline" />
  </project>
  <project name="lcaf-component-policy" path="components/policy" remote="launch-dso-platform" revision="refs/tags/1.1.1" dso_override_attribute_revision='${POLICY_VER}'>
  </project>
</manifest>
